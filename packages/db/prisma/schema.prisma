// ClipForge — Prisma schema (SQLite for zero-dependency local dev on Windows/Node).
//
// The schema is intentionally PORTABLE: it uses String fields (not native enums) and
// JSON-encoded String fields (not scalar lists or the Json type, which SQLite doesn't
// support in Prisma). These are valid on BOTH SQLite and PostgreSQL. To run on Postgres in
// production, change the datasource `provider` to "postgresql" and point DATABASE_URL at it —
// no other schema edits are required. String value sets are documented in packages/types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// String value sets (documented; enforced in the app layer via @clipforge/types)
//   Role:            OWNER | ADMIN | MEMBER
//   PlanTier:        FREE | PRO | BUSINESS | ENTERPRISE
//   SubscriptionStatus: ACTIVE | TRIALING | PAST_DUE | CANCELED | INCOMPLETE
//   VideoStatus:     UPLOADING | UPLOADED | PROCESSING | READY | FAILED
//   JobStatus:       QUEUED | RUNNING | COMPLETED | FAILED | CANCELED
//   PipelineStage:   UPLOAD | PROBE_METADATA | ... | EXPORT
//   WorkerType:      CPU | GPU | PRIORITY | RETRY
//   AspectRatio:     R_9_16 | R_16_9 | R_1_1 | R_4_5
//   Resolution:      P1080 | P1440 | P2160
//   Platform:        TIKTOK | INSTAGRAM | YOUTUBE_SHORTS | FACEBOOK | LINKEDIN | X | PODCAST | CUSTOM
//   EditingStyle:    PODCAST | EDUCATIONAL | GAMING | INTERVIEW | VLOG | NEWS | AUTO
//   TimelineEventType: HOOK | EMOTION | SILENCE | SCENE_CHANGE | SPEAKER_CHANGE | KEYWORD
//   StorageProvider: LOCAL | MINIO | S3 | R2 | SUPABASE
//   AiModelKind:     TRANSCRIPTION | DIARIZATION | LLM | VISION | EMBEDDING
//   CreditTxnType:   TOPUP | USAGE | REFUND | MONTHLY_ALLOCATION | ADJUSTMENT
//   NotificationType: JOB_COMPLETED | JOB_FAILED | BILLING | SYSTEM | MENTION
// JSON-encoded String fields: Transcript.segments, Clip.hashtags, *.meta, *.config,
//   Plan.features, Job.stageLogs, AiProfile.preferredPlatforms/preferences.
// ===========================================================================

// ===========================================================================
// Auth (Auth.js / NextAuth compatible) + Users
// ===========================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime?
  isAdmin       Boolean   @default(false)
  locale        String    @default("en")

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  aiProfile     AiProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================================================
// Teams / RBAC / Billing owner
// ===========================================================================

model Team {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  memberships  Membership[]
  projects     Project[]
  subscription Subscription?
  creditWallet CreditWallet?
  usageRecords UsageRecord[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   String @default("MEMBER")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// ===========================================================================
// Projects / Videos / Clips
// ===========================================================================

model Project {
  id           String  @id @default(cuid())
  teamId       String
  name         String
  description  String?
  editingStyle String  @default("AUTO")

  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model Video {
  id        String @id @default(cuid())
  projectId String
  title     String
  status    String @default("UPLOADING")

  // Storage
  storageProvider String  @default("LOCAL")
  storageKey      String
  sizeBytes       BigInt?
  originalName    String?
  mimeType        String?

  // Full media metadata
  durationSec Float?
  fps         Float?
  bitrate     Int?
  videoCodec  String?
  width       Int?
  height      Int?
  rotation    Int?
  aspectRatio String?
  audioCodec  String?
  sampleRate  Int?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips      Clip[]
  clipSeries ClipSeries[]
  transcript Transcript?
  jobs       Job[]
  timeline   TimelineEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model Clip {
  id       String  @id @default(cuid())
  videoId  String
  seriesId String?

  title        String
  startSec     Float
  endSec       Float
  aspectRatio  String @default("R_9_16")
  editingStyle String @default("AUTO")

  // ClipForge differentiators
  qualityScore    Float?
  viralityScore   Float?
  hookScore       Float?
  reasoning       String? // editable AI explanation of why this clip was chosen
  reasoningEdited Boolean @default(false)
  seriesPart      Int? // Part 1 / 2 / 3 within a series

  // AI-generated metadata
  aiTitle      String?
  description  String?
  hashtags     String? // JSON string[]
  storageKey   String?
  thumbnailKey String?

  video     Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series    ClipSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  subtitles Subtitle[]
  exports   ExportTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([seriesId])
}

// Auto clip series (Part 1 / 2 / 3) — narrative continuity across clips
model ClipSeries {
  id      String  @id @default(cuid())
  videoId String
  title   String
  summary String?
  clips   Clip[]

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([videoId])
}

// Insight timeline: hooks, emotions, silence, scene/speaker changes, keywords
model TimelineEvent {
  id       String  @id @default(cuid())
  videoId  String
  type     String
  startSec Float
  endSec   Float?
  label    String?
  score    Float?
  meta     String? // JSON

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, type])
}

model Transcript {
  id        String  @id @default(cuid())
  videoId   String  @unique
  language  String  @default("en")
  fullText  String
  segments  String // JSON [{start,end,text,speaker}]
  wordCount Int     @default(0)
  model     String?

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Subtitle {
  id         String  @id @default(cuid())
  clipId     String
  language   String  @default("en")
  format     String  @default("ass") // srt | ass | vtt
  styleKey   String  @default("default")
  content    String
  storageKey String?

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId])
}

model ExportTarget {
  id          String  @id @default(cuid())
  clipId      String
  platform    String
  presetKey   String
  aspectRatio String
  resolution  String  @default("P1080")
  status      String  @default("QUEUED")
  storageKey  String?
  sizeBytes   BigInt?

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId])
}

// Configurable export presets
model ExportPreset {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  platform    String
  aspectRatio String
  resolution  String
  fps         Int     @default(30)
  maxDuration Int?
  config      String? // JSON
  isSystem    Boolean @default(true)

  createdAt DateTime @default(now())
}

// ===========================================================================
// Jobs / Queue-per-stage
// ===========================================================================

model Job {
  id              String    @id @default(cuid())
  videoId         String
  status          String    @default("QUEUED")
  stage           String    @default("UPLOAD")
  workerType      String    @default("CPU")
  pipelineVersion Int       @default(1)
  progress        Float     @default(0)
  queueName       String    @default("transcription")
  error           String?
  stageLogs       String? // JSON
  startedAt       DateTime?
  finishedAt      DateTime?

  video       Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  usageRecord UsageRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([status, stage])
}

// ===========================================================================
// Billing / Subscriptions / Credit wallet
// ===========================================================================

model Plan {
  id             String  @id @default(cuid())
  tier           String  @unique
  name           String
  priceMonthly   Int
  stripePriceId  String?
  monthlyCredits Int     @default(0)
  maxUploadMb    Int     @default(500)
  maxExportRes   String  @default("P1080")
  features       String? // JSON

  subscriptions Subscription[]

  createdAt DateTime @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  teamId               String    @unique
  planId               String
  status               String    @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id              String  @id @default(cuid())
  teamId          String
  stripeInvoiceId String? @unique
  amountDue       Int
  amountPaid      Int
  currency        String  @default("usd")
  status          String
  hostedUrl       String?
  pdfUrl          String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teamId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int?
  amountOff      Int?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)

  createdAt DateTime @default(now())
}

model CreditWallet {
  id      String @id @default(cuid())
  teamId  String @unique
  balance Int    @default(0)

  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id           String  @id @default(cuid())
  walletId     String
  type         String
  amount       Int
  balanceAfter Int
  reason       String?
  meta         String? // JSON

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([walletId])
}

// ===========================================================================
// Usage analytics & cost estimation
// ===========================================================================

model UsageRecord {
  id     String  @id @default(cuid())
  teamId String
  jobId  String? @unique

  processingMs     Int     @default(0)
  cpuSeconds       Float   @default(0)
  gpuSeconds       Float   @default(0)
  minutesProcessed Float   @default(0)
  wordsTranscribed Int     @default(0)
  clipsGenerated   Int     @default(0)
  storageBytes     BigInt  @default(0)
  bandwidthBytes   BigInt  @default(0)
  estimatedCostUsd Float   @default(0)
  modelKey         String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([teamId])
}

// ===========================================================================
// AI Model Registry
// ===========================================================================

model AiModel {
  id                 String  @id @default(cuid())
  key                String  @unique
  name               String
  kind               String
  provider           String
  isDefault          Boolean @default(false)
  experimental       Boolean @default(false)
  costPerMinuteUsd   Float?
  costPer1kTokensUsd Float?
  config             String? // JSON
  enabled            Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([kind])
}

// ===========================================================================
// Personalized AI profile — learns user editing preferences
// ===========================================================================

model AiProfile {
  id     String @id @default(cuid())
  userId String @unique

  preferredStyle     String  @default("AUTO")
  preferredPlatforms String? // JSON Platform[]
  captionStyleKey    String  @default("default")
  minClipQuality     Float   @default(60)
  preferences        String? // JSON

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Notifications / Audit / API keys
// ===========================================================================

model Notification {
  id     String  @id @default(cuid())
  userId String
  type   String
  title  String
  body   String?
  read   Boolean @default(false)
  meta   String? // JSON

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id       String  @id @default(cuid())
  userId   String?
  action   String
  entity   String?
  entityId String?
  ip       String?
  meta     String? // JSON

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  hashedKey  String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
