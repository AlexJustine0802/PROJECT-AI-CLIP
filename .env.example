# ==========================================================================
# ClipForge — environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ==========================================================================

NODE_ENV=development

# --------------------------------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge?schema=public

# --------------------------------------------------------------------------
# Redis (queues, cache, rate limiting)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# Services
# --------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --------------------------------------------------------------------------
# Auth.js (NextAuth) — self-hosted
# Generate a secret: `openssl rand -base64 32`
# --------------------------------------------------------------------------
AUTH_SECRET=changeme-generate-a-32-byte-secret
AUTH_URL=http://localhost:3000
# Shared secret used by the API to verify Auth.js-issued JWTs.
JWT_SECRET=changeme-generate-a-32-byte-secret
JWT_EXPIRES_IN=7d

# OAuth providers (leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (verification / password reset) — SMTP
EMAIL_SERVER=smtp://user:pass@localhost:1025
EMAIL_FROM=no-reply@clipforge.local

# --------------------------------------------------------------------------
# Storage provider abstraction
# STORAGE_PROVIDER = local | minio | s3 | r2 | supabase
# --------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_BUCKET=clipforge
STORAGE_LOCAL_ROOT=./storage
# S3 / R2 / MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=clipforge
S3_SECRET_ACCESS_KEY=clipforge
S3_FORCE_PATH_STYLE=true
# Cloudflare R2
R2_ACCOUNT_ID=
# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# AI service / model registry
# --------------------------------------------------------------------------
# When true, the whole pipeline runs on CPU with realistic mock outputs (no downloads).
AI_USE_STUBS=true
# Transcription model: whisper-tiny | whisper-base | whisper-small | whisper-medium | whisper-large-v3
AI_TRANSCRIBE_MODEL=whisper-small
AI_WHISPER_DEVICE=cpu               # cpu | cuda
AI_WHISPER_COMPUTE_TYPE=int8        # int8 | float16 | float32
AI_PIPELINE_VERSION=1
# Optional cloud AI providers (used only if configured and the flag is enabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --------------------------------------------------------------------------
# Feature flags
# --------------------------------------------------------------------------
ENABLE_GPU=false
ENABLE_BILLING=true
ENABLE_ADMIN=true
ENABLE_ANALYTICS=true
ENABLE_EXPORT_4K=false
ENABLE_EXPERIMENTAL_MODELS=false
ENABLE_AI_PROFILES=true

# --------------------------------------------------------------------------
# Stripe (billing) — test mode keys
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=clipforge
LOG_LEVEL=info
PROMETHEUS_ENABLED=true

# --------------------------------------------------------------------------
# Rate limiting
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
