# ==========================================================================
# ClipForge — environment configuration
# Copy to .env and fill in. Never commit real secrets.
#
# DEFAULTS ARE ZERO-DEPENDENCY: SQLite + in-process queue + in-memory cache +
# in-process Node AI + local file storage. No Docker, Postgres, Redis, MinIO, or
# Python required. Runs on Windows 11 with only Node.js 20+.
# ==========================================================================

NODE_ENV=development

# --------------------------------------------------------------------------
# Database — SQLite by default (a single file, no server).
# For production Postgres: change packages/db/prisma/schema.prisma provider to
# "postgresql" and set a postgresql:// URL here.
# --------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# --------------------------------------------------------------------------
# Runtime drivers — Node-only defaults (no external services).
#   QUEUE_DRIVER = memory | bullmq   (bullmq needs REDIS_URL)
#   CACHE_DRIVER = memory | redis    (redis  needs REDIS_URL)
#   AI_DRIVER    = node   | http     (http   needs the Python service at AI_SERVICE_URL)
# --------------------------------------------------------------------------
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
AI_DRIVER=node

# Only needed if you switch QUEUE_DRIVER/CACHE_DRIVER to their Redis variants.
REDIS_URL=redis://localhost:6379
# Only needed if AI_DRIVER=http (the optional Python FastAPI service).
AI_SERVICE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# Services
# --------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --------------------------------------------------------------------------
# Auth.js (NextAuth) — self-hosted. Generate: `openssl rand -base64 32`
# --------------------------------------------------------------------------
AUTH_SECRET=changeme-generate-a-32-byte-secret
AUTH_URL=http://localhost:3000
JWT_SECRET=changeme-generate-a-32-byte-secret
JWT_EXPIRES_IN=7d

# OAuth (optional — leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (optional — verification / password reset)
EMAIL_SERVER=smtp://user:pass@localhost:1025
EMAIL_FROM=no-reply@clipforge.local

# --------------------------------------------------------------------------
# Storage — local filesystem by default (files under STORAGE_LOCAL_ROOT).
# STORAGE_PROVIDER = local | minio | s3 | r2 | supabase
# --------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=clipforge
STORAGE_LOCAL_ROOT=./storage
# S3 / R2 / MinIO / Supabase (only if STORAGE_PROVIDER is one of those)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --------------------------------------------------------------------------
# AI / model registry
# --------------------------------------------------------------------------
# When AI_DRIVER=http, run the Python service; AI_USE_STUBS controls real vs mock inference there.
AI_USE_STUBS=true
AI_TRANSCRIBE_MODEL=whisper-small
AI_PIPELINE_VERSION=1
# Optional cloud AI provider keys (only if you wire those providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --------------------------------------------------------------------------
# Feature flags
# --------------------------------------------------------------------------
ENABLE_GPU=false
ENABLE_BILLING=true
ENABLE_ADMIN=true
ENABLE_ANALYTICS=true
ENABLE_EXPORT_4K=false
ENABLE_EXPERIMENTAL_MODELS=false
ENABLE_AI_PROFILES=true

# --------------------------------------------------------------------------
# Stripe (optional, billing) — test mode keys
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --------------------------------------------------------------------------
# Worker concurrency (in-process queue)
# --------------------------------------------------------------------------
WORKER_CPU_CONCURRENCY=2

# --------------------------------------------------------------------------
# Observability (optional)
# --------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
